---
import BaseLayout from '../layouts/BaseLayout.astro';

// Detect if the current URL starts with /ta
const { pathname } = Astro.url;
const isTamil = pathname.startsWith('/ta/');

// Set dynamic content based on language
const lang = isTamil ? "ta" : "en";
const title = isTamil ? "பக்கம் காணப்படவில்லை" : "Page not found";
const message = isTamil 
  ? "நீங்கள் தேடும் பக்கம் இங்கு இல்லை." 
  : "The page you're looking for doesn't exist.";
const buttonText = isTamil ? "முகப்பு பக்கத்திற்குச் செல்ல" : "Go home";
const homeLink = isTamil ? "/ta/" : "/en/";
const descriptionText = isTamil 
  ? "நீங்கள் தேடும் பக்கம் காணப்படவில்லை. தயவுசெய்து ஒளிநெறி பீடத்தின் முகப்புப் பக்கத்திற்குத் திரும்புங்கள்." 
  : "The page you are looking for was not found. Please return to the Olineri Peedam home page.";
---

<BaseLayout lang={lang} title={title} description={descriptionText}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <h2 class="text-4xl font-bold text-amber-900">{title}</h2>
    
    <!-- ADDED: mb-10 for significant spacing below the message -->
    <p class="mt-6 mb-10 text-xl text-gray-600">{message}</p>
    <a 
        href={homeLink} 
        class="bg-[#8B4513] text-white px-6 py-2 rounded-full text-sm font-black hover:bg-[#B8860B] transition-all shadow-md"
    >
        {buttonText}
    </a>
  </div>
</BaseLayout>