---
import BaseLayout from '../../layouts/BaseLayout.astro';
const articles = [
  { title: "The Significance of Thai Poosam", date: "Jan 2026", excerpt: "Understanding the spiritual alignment during this sacred time..." },
  { title: "Compassion Toward All Living Beings", date: "Feb 2026", excerpt: "How Jeeva Karunyam forms the foundation of Olineri..." }
];
---
<BaseLayout lang="en" title="Articles">
  <h2 class="text-3xl font-bold text-amber-900 mb-8 border-b pb-2">Spiritual Articles</h2>
  <div class="space-y-8">
    {articles.map(post => (
      <article class="p-6 bg-amber-50 rounded-xl border border-amber-100">
        <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">{post.date}</span>
        <h3 class="text-2xl font-bold text-amber-900 mt-1">{post.title}</h3>
        <p class="text-gray-700 mt-3 italic leading-relaxed">{post.excerpt}</p>
        <!--<a href="#" class="inline-block mt-4 text-blue-700 font-semibold hover:underline">Read Full Article →</a>-->
      </article>
    ))}
  </div>
</BaseLayout>