---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Learn" lang="en">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-[#800000] mb-8">Spiritual Training</h1>
    
    <div class="prose prose-lg text-gray-700">
      <p class="mb-10">
        Here you can deeply learn the principles of Suddha Sanmarga as shown by Vallalar and the essence of Thiruvarutpa.
      </p>

      <!-- Combined Training and Q&A Section -->
      <div class="bg-amber-50 p-8 rounded-lg border border-amber-200 mb-12 space-y-10">
        
        <!-- Part 1: Training List -->
        <div>
          <h2 class="text-2xl font-bold text-[#800000] mb-6">Trainings Offered at Vallalar Adhiyinam:</h2>
          <ul class="list-decimal list-inside space-y-3 text-lg font-medium text-gray-800">
            <li>Training on Divine Contemplation in Lamp Light (Deepam)</li>
            <li>Relational Ethics Training (Saarbozhukkam)</li>
            <li>Fivefold Discipline Training (Aindhozhukkam)</li>
            <li>Divine Relationship Training</li>
            <li>Wisdom about Thiruvadi and its Initiation</li>
          </ul>
        </div>

        <hr class="border-amber-200" />

        <!-- Part 2: Video Q&A -->
        <div class="space-y-12">
          
          <!-- Q&A 1 -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              Divine Contemplation on Lamp — An Introduction
            </h3>
            <div class="aspect-video">
              <iframe 
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/Wnx4BfcM2wg" 
                title="Introduction to Divine Contemplation on Lamp"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

          <!-- Q&A 2 -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              How to Practice Divine Contemplation on Lamp?
            </h3>
            <div class="aspect-video">
              <iframe 
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/iNfQkijvv0M" 
                title="How to practice Deepa Bavanai"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

          <!-- Q&A 3 -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              What is Relational Ethics (Saarbozhukkam) Training?
            </h3>
            <div class="aspect-video">
              <iframe 
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/pP_AsgnzDHU" 
                title="Relational Ethics Training"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

          <!-- Q&A 4 -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              What is Fivefold Discipline (Aindhozhukkam) Training?
            </h3>
            <div class="aspect-video">
              <iframe 
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/jDvDeDt_4DY" 
                title="Fivefold Discipline Training"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</BaseLayout>