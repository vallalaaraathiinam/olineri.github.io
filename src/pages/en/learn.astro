---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Learn | Olineri" lang="en">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-[#800000] mb-8">The Path of Learning</h1>
    <div class="prose prose-lg text-gray-700">
      <p class="mb-6">
        Explore the foundational principles of <strong>Samarasa Sutha Sanmargam</strong> and the vast spiritual legacy of Vallalar.
      </p>
      
      <div class="grid md:grid-cols-2 gap-8 mt-12">
        <div class="p-8 bg-white border-t-4 border-[#FF9933] shadow-sm rounded-b-lg">
          <h2 class="text-2xl font-bold text-[#800000] mb-3">Compassion</h2>
          <p>Understanding Jeevakarunyam as the primary discipline for spiritual growth.</p>
        </div>
        <div class="p-8 bg-white border-t-4 border-[#FF9933] shadow-sm rounded-b-lg">
          <h2 class="text-2xl font-bold text-[#800000] mb-3">Divine Light</h2>
          <p>The practice of worshiping the Arutperunjothi (Vast Grace-Light).</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>