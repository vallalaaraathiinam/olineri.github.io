---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Services">
  <div class="space-y-12">
    <header class="text-center">
      <h2 class="text-3xl font-bold text-amber-900">Our Services & Activities</h2>
      <p class="text-gray-600 mt-2">Dedicated to spiritual growth and community welfare.</p>
    </header>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-amber-50 p-8 rounded-2xl border border-amber-100 shadow-sm">
        <h3 class="text-2xl font-bold text-amber-800 mb-4 flex items-center gap-2">
          📍 Trichy Sabhai
        </h3>
        <ul class="space-y-4 text-gray-700">
          <li class="flex gap-3">
            <span class="text-amber-500">✦</span>
            <div><strong>Food Donation:</strong> Regular food donation services for the needy and spiritual seekers.</div>
          </li>
          <li class="flex gap-3">
            <span class="text-amber-500">✦</span>
            <div><strong>Daily Satsang:</strong> Daily Early Morning Satsang and Training on Lamp Meditation. Listening to Discourses at night</div>
          </li>
        </ul>
      </div>

      <div class="bg-blue-50 p-8 rounded-2xl border border-blue-100 shadow-sm">
        <h3 class="text-2xl font-bold text-blue-800 mb-4 flex items-center gap-2">
          📍 Chennai Sabhai
        </h3>
        <ul class="space-y-4 text-gray-700">
          <li class="flex gap-3">
            <span class="text-blue-500">✦</span>
            <div><strong>Weekly Classes:</strong> In-depth discourses on Vallalaar's teachings and Olineri.</div>
          </li>
          <!--<li class="flex gap-3">
            <span class="text-blue-500">✦</span>
            <div><strong>Book Distribution:</strong> Access to our library of 13 primary publications.</div>
          </li>-->
          <li class="flex gap-3">
            <span class="text-blue-500">✦</span>
            <div><strong>Spiritual Guidance:</strong> One-on-one sessions for those beginning the path.</div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>