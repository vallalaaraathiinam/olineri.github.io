---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Contact Us">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold text-amber-900 mb-8 border-b pb-2 text-center">Get in Touch</h2>

    <div class="grid md:grid-cols-2 gap-12 mt-10">
      <div class="space-y-4">
        <h3 class="text-xl font-bold text-amber-800 uppercase tracking-wider">Trichy Sabhai</h3>
        <p class="text-gray-700 leading-relaxed">
          123, Olineri Street,<br />
          Near Main Temple,<br />
          Trichy, Tamil Nadu - 620001
        </p>
        <div class="pt-4 space-y-2 text-sm">
          <p><strong>Phone:</strong> <a href="tel:+919876543210" class="text-blue-600 hover:underline">+91 98765 43210</a></p>
          <p><strong>Email:</strong> info@olineri.org</p>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-xl font-bold text-amber-800 uppercase tracking-wider">Chennai Sabhai</h3>
        <p class="text-gray-700 leading-relaxed">
          45, Vallalaar Avenue,<br />
          T. Nagar,<br />
          Chennai, Tamil Nadu - 600017
        </p>
        <div class="pt-4 space-y-2 text-sm">
          <p><strong>Phone:</strong> <a href="tel:+919876543211" class="text-blue-600 hover:underline">+91 98765 43211</a></p>
          <p><strong>Email:</strong> chennai@olineri.org</p>
        </div>
      </div>
    </div>

    <div class="mt-20 p-8 bg-amber-50 rounded-xl border border-amber-100 text-center">
      <h3 class="text-lg font-bold text-amber-900 mb-2">Visit Our Sabhai</h3>
      <p class="text-gray-600">Our halls are open for meditation and spiritual discourse daily from 6:00 AM to 8:00 PM. All are welcome regardless of caste or creed.</p>
    </div>
  </div>
</BaseLayout>