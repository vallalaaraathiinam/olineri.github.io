---
/**
 * src/pages/en/learn/essays/[slug].astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Essay detail page — English version (dynamic route).
 * One file generates ALL essay detail pages at build time via getStaticPaths().
 * Adding a new essay to essays.js creates its page on the next build.
 * English essay detail page. Uses bodyEn from essays.js.
 * Tamil equivalent: src/pages/ta/learn/essays/[slug].astro
 * ─────────────────────────────────────────────────────────────────────────────
 */

import { marked } from 'marked';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { essaysData } from '../../../../data/essays.js';

export async function getStaticPaths() {
  return essaysData.map((essay) => ({
    params: { slug: essay.slug },
    props:  { essay },
  }));
}

const { essay } = Astro.props;
const bodyHtml = marked(essay.bodyEn);
const formattedDate = new Date(essay.date).toLocaleDateString('en-IN', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout lang="en" title={essay.titleEn} pageType="essays">
  <article>

    <a href="/en/learn/essays" class="inline-flex items-center gap-1 text-sm font-bold text-[#8B4513] hover:text-[#B8860B] transition-colors mb-8">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Essays
    </a>

    <p class="text-xs font-bold text-amber-600 uppercase tracking-widest mb-3">{formattedDate}</p>

    <h1 class="text-xl md:text-xl font-bold text-[#8B4513] leading-tight mb-6" style="font-family: 'Playfair Display', serif;">
      {essay.titleEn}
    </h1>
    
    <div class="prose prose-lg max-w-none" set:html={bodyHtml} />

    <div class="mt-12 pt-8 border-t border-amber-100">
      <a href="/en/learn/essays" class="inline-flex items-center gap-2 bg-[#8B4513] text-white px-6 py-2 rounded-full text-sm font-bold hover:bg-[#B8860B] transition-all shadow-sm">
        ← Back to all essays
      </a>
    </div>

  </article>
</BaseLayout>
