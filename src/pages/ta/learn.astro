---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="பயில்க | ஒளிநெறி" lang="ta">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-[#800000] mb-8">ஞானப் பயிற்சி</h1>
    <div class="prose prose-lg text-gray-700">
      <p class="mb-6 font-tamil">
        வள்ளலார் காட்டிய சுத்த சன்மார்க்க நெறிகளையும், திருவருட்பாவின் சாரத்தையும் இங்கே ஆழமாகப் பயிலலாம்.
      </p>
      
      <div class="grid md:grid-cols-2 gap-8 mt-12">
        <div class="p-8 bg-white border-t-4 border-[#FF9933] shadow-sm rounded-b-lg">
          <h2 class="text-2xl font-bold text-[#800000] mb-3">ஜீவகாருண்யம்</h2>
          <p>ஆன்ம நேய ஒருமைப்பாட்டின் முதல் படியான உயிரிரக்கத்தைப் பற்றி அறிதல்.</p>
        </div>
        <div class="p-8 bg-white border-t-4 border-[#FF9933] shadow-sm rounded-b-lg">
          <h2 class="text-2xl font-bold text-[#800000] mb-3">அருட்பெருஞ்ஜோதி</h2>
          <p>இறைவனை ஒளி வடிவில் காணும் ஞான மார்க்கத்தைப் பயிலுதல்.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>