---
/**
 * src/pages/ta/learn.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Spiritual training page — Tamil version.
 *
 * Two parts within a single card:
 *   Part 1 — List of the 5 trainings offered at Vallalar Adhiyinam
 *   Part 2 — 4 embedded YouTube Q&A videos (one per training topic)
 *
 * YouTube iframes:
 *   - Each has a descriptive title attribute (accessibility requirement)
 *   - aspect-video wrapper (Tailwind) maintains 16:9 ratio at all screen sizes
 *   - allow="..." permits only the capabilities YouTube needs to function
 *   - frameborder="0" removes the default iframe border (cosmetic)
 *
 * English equivalent: src/pages/en/learn.astro
 * ─────────────────────────────────────────────────────────────────────────────
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="பயில்க" lang="ta">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="text-4xl font-bold text-[#800000] mb-8">ஞானப் பயிற்சி</h1>

    <div class="prose prose-lg text-gray-700">
      <p class="mb-10 font-tamil">
        வள்ளலார் காட்டிய சுத்த சன்மார்க்க நெறிகளையும், திருவருட்பாவின் சாரத்தையும்
        இங்கே ஆழமாகப் பயிலலாம்.
      </p>

      <!-- Outer card wraps both Part 1 (list) and Part 2 (videos) -->
      <div class="bg-amber-50 p-8 rounded-lg border border-amber-200 mb-12 space-y-10">

        <!-- ── Part 1: Training list ──────────────────────────────────────── -->
        <div>
          <h2 class="text-2xl font-bold text-[#800000] mb-6">
            வள்ளலார் ஆதியினத்தில் வழங்கப்படும் பயிற்சிகள்:
          </h2>
          <ul class="list-decimal list-inside space-y-3 text-lg font-medium text-gray-800">
            <li>தீபத்தில் தெய்வ பாவனை பயிற்சி</li>
            <li>சார்பொழுக்கப் பயிற்சி</li>
            <li>ஐந்தொழுக்கப்பயிற்சி</li>
            <li>இறைமை உறவு பயிற்சி</li>
            <li>திருவடி ஞானம் மற்றும் திருவடி தீட்சை</li>
          </ul>
        </div>

        <hr class="border-amber-200" />

        <!-- ── Part 2: Q&A video embeds ──────────────────────────────────── -->
        <div class="space-y-12">

          <!-- Video 1: Introduction to Deepa Bavanai -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              தீபத்தில் தெய்வ பாவனை  - ஓர் அறிமுகம்
            </h3>
            <!-- aspect-video maintains 16:9 ratio as the container resizes -->
            <div class="aspect-video">
              <iframe
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/Wnx4BfcM2wg"
                title="தீபத்தில் தெய்வ பாவனை — அறிமுகம்"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <!-- Video 2: How to practice Deepa Bavanai -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              தீபத்தில் தெய்வ பாவனை பயிற்சி எவ்வாறு செய்வது?
            </h3>
            <div class="aspect-video">
              <iframe 
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/iNfQkijvv0M" 
                title="தீபத்தில் தெய்வ பாவனை எவ்வாறு செய்வது?"
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

          <!-- Video 3: Relational Ethics training -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              சார்பொழுக்கப் பயிற்சி என்றால் என்ன?
            </h3>
            <div class="aspect-video">
              <iframe
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/pP_AsgnzDHU"
                title="சார்பொழுக்கப் பயிற்சி என்றால் என்ன?"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <!-- Video 4: Fivefold Discipline training -->
          <div class="space-y-4">
            <h3 class="text-xl font-bold text-[#800000] flex items-start">
              ஐந்தொழுக்கப் பயிற்சி என்றால் என்ன?
            </h3>
            <div class="aspect-video">
              <iframe
                class="w-full h-full rounded shadow-sm border border-gray-200"
                src="https://www.youtube.com/embed/jDvDeDt_4DY"
                title="ஐந்தொழுக்கப் பயிற்சி என்றால் என்ன?"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>

        </div>
        <!-- end Part 2 -->

      </div>
    </div>
  </section>
</BaseLayout>
