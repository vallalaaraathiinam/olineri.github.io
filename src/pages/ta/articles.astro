---
import BaseLayout from '../../layouts/BaseLayout.astro';
const articles = [
  { title: "தைப்பூசத்தின் முக்கியத்துவம்", date: "ஜனவரி 2026", excerpt: "இந்த புனிதமான காலத்தில் ஆன்மீக ரீதியாக நாம் பெற வேண்டிய பலன்கள்..." },
  { title: "ஜீவகாருண்யத்தின் அவசியம்", date: "பிப்ரவரி 2026", excerpt: "ஒளிநெறி வாழ்க்கைக்கு ஜீவகாருண்யம் எப்படி அடிப்படையாக அமைகிறது..." }
];
---
<BaseLayout lang="ta" title="கட்டுரைகள்">
  <h2 class="text-3xl font-bold text-amber-900 mb-8 border-b pb-2 text-right">ஆன்மீக கட்டுரைகள்</h2>
  <div class="space-y-8 text-right">
    {articles.map(post => (
      <article class="p-6 bg-amber-50 rounded-xl border border-amber-100">
        <span class="text-xs font-bold text-amber-600 uppercase tracking-widest">{post.date}</span>
        <h3 class="text-2xl font-bold text-amber-900 mt-1">{post.title}</h3>
        <p class="text-gray-700 mt-3 italic leading-relaxed">{post.excerpt}</p>
        <!--<a href="#" class="inline-block mt-4 text-blue-700 font-semibold hover:underline">முழுக்கட்டுரையை வாசிக்க ←</a>-->
      </article>
    ))}
  </div>
</BaseLayout>