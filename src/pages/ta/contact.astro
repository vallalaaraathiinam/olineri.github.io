---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout lang="ta" title="தொடர்பு கொள்ள">
  <div class="max-w-4xl mx-auto text-right">
    <h2 class="text-3xl font-bold text-amber-900 mb-8 border-b pb-2 text-center">தொடர்பு கொள்ள</h2>

    <div class="grid md:grid-cols-2 gap-12 mt-10">
      <div class="space-y-4">
        <h3 class="text-xl font-bold text-amber-800">திருச்சி சபை</h3>
        <p class="text-gray-700 leading-relaxed">
          123, ஒளிநெறி தெரு,<br />
          முக்கிய ஆலயம் அருகில்,<br />
          திருச்சி - 620001
        </p>
        <div class="pt-4 space-y-2 text-sm">
          <p><strong>தொலைபேசி:</strong> <a href="tel:+919876543210" class="text-blue-600">+91 98765 43210</a></p>
          <p><strong>மின்னஞ்சல்:</strong> info@olineri.org</p>
        </div>
      </div>

      <div class="space-y-4 border-t pt-8 md:border-t-0 md:pt-0">
        <h3 class="text-xl font-bold text-amber-800">சென்னை சபை</h3>
        <p class="text-gray-700 leading-relaxed">
          45, வள்ளலார் அவென்யூ,<br />
          தி. நகர்,<br />
          சென்னை - 600017
        </p>
        <div class="pt-4 space-y-2 text-sm">
          <p><strong>தொலைபேசி:</strong> <a href="tel:+919876543211" class="text-blue-600">+91 98765 43211</a></p>
          <p><strong>மின்னஞ்சல்:</strong> chennai@olineri.org</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>