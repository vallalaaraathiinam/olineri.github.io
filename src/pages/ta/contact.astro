---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="தொடர்புக்கு" lang="ta">
  <div class="max-w-6xl mx-auto py-12 px-4">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-[#8B4513] mb-4">தொடர்பு கொள்ள</h2>
      <p class="text-[#B8860B] italic text-lg font-tamil">"ஜீவகாருண்யமே மோட்ச வீட்டின் திறவுகோல்."</p>
      <div class="h-1 w-24 bg-[#FFD700] mx-auto mt-6"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      
      <div class="bg-white p-8 rounded-2xl border border-[#FFD700]/30 shadow-lg hover:shadow-xl transition-shadow">
        <h3 class="text-2xl font-bold text-[#8B4513] mb-6 flex items-center gap-3">
          <span class="text-3xl">🏛️</span>ஒளிநெறி பீடம், சென்னை
        </h3>
        <div class="space-y-4 text-gray-700">
          <p class="flex items-start gap-3">
            <strong class="text-[#B8860B]">முகவரி:</strong> 
            <span>அம்பலவாணர் குடில்,<br>எண்.10/11, புதுத்தெரு, விநாயகபுரம், அம்பத்தூர் ஓ.டி, சென்னை - 600053<br/> தமிழ்நாடு</span>
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொலைபேசி:</strong> 
            <a href="tel:+919444734634" class="hover:text-[#D4AF37]">+91 94447 34634</a>
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொடர்பாளர்:</strong> 
            மகேஸ்வரன்
          </p>
        </div>

        <div class="mt-8 rounded-xl overflow-hidden h-64 border border-gray-100">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d485.69137252877937!2d80.15099816019828!3d13.128871895075422!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a5263042a76416d%3A0xabc40e2f85891864!2sOlineri%20Peedam!5e0!3m2!1sen!2sin!4v1777216498763!5m2!1sen!2sin" 
            width="100%" height="100%" style="border:0;" 
            allowfullscreen="" loading="lazy">
          </iframe>
        </div>
      </div>

      <div class="bg-white p-8 rounded-2xl border border-[#FFD700]/30 shadow-lg hover:shadow-xl transition-shadow">
        <h3 class="text-2xl font-bold text-[#8B4513] mb-6 flex items-center gap-3">
          <span class="text-3xl">🏛️</span>ஒளிநெறி பீடம், திருச்சி
        </h3>
        <div class="space-y-4 text-gray-700">
          <p class="flex items-start gap-3">
            <strong class="text-[#B8860B]">முகவரி:</strong> 
            <span>5, சோழா அவென்யூ,<br>கல்லணை சாலை, திருவெறும்பூர்<br/>திருச்சி - 620013<br/> தமிழ்நாடு</span>
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொலைபேசி:</strong> 
            <a href="tel:+918667754280" class="hover:text-[#D4AF37]">+91 86677 54280</a>
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொடர்பாளர்:</strong> 
            தியாகராஜன்
          </p>
        </div>
        
        <div class="mt-8 rounded-xl overflow-hidden h-64 border border-gray-100">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.189087489129!2d78.76966361416419!3d10.7968253!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3baaf373379bdac5%3A0x19e4ff4579927bd6!2sManitham%20Homeo%20Healing%20Centre!5e0!3m2!1sen!2sin!4v1777217098188!5m2!1sen!2sin" 
            width="100%" height="100%" style="border:0;" 
            allowfullscreen="" loading="lazy">
          </iframe>
        </div>
      </div>
      
    </div>
  </div>
</BaseLayout>