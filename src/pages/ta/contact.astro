---
/**
 * src/pages/ta/contact.astro
 * ─────────────────────────────────────────────────────────────────────────────
 * Contact page — Tamil version.
 *
 * Shows contact information and embedded Google Maps for two locations:
 *   1. Chennai  — Olineri Peedam, Ambattur OT
 *   2. Trichy   — Olineri Peedam, Thiruverumbur
 *
 * Google Maps iframes:
 *   - sandbox attribute restricts iframe capabilities to only what Maps needs,
 *     reducing the attack surface if Google's CDN were ever compromised
 *   - title attribute is required for screen reader accessibility
 *   - loading="lazy" defers iframe load until near viewport (performance)
 *
 * Phone links use tel: protocol so mobile users can tap-to-call directly.
 * WhatsApp links use wa.me with a pre-filled message from CONTACT_DETAILS.
 *
 * English equivalent: src/pages/en/contact.astro
 * ─────────────────────────────────────────────────────────────────────────────
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_DETAILS } from '../../constants/seo';

const { whatsapp_chennai, whatsapp_trichy } = CONTACT_DETAILS;

/*
 * BuildingIcon — reusable inline SVG for the section headings.
 * Defined as a string constant and rendered via set:html to avoid
 * repeating the SVG markup twice. aria-hidden is set on the parent
 * span in the template, so no role needed here.
 */
const BuildingIcon = `
  <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-[#8B4513]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
  </svg>
`;

/*
 * WhatsAppIcon — reusable inline SVG for WhatsApp links.
 * Rendered via set:html alongside phone numbers.
 */
const WhatsAppIcon = `
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.862L.057 23.571a.75.75 0 00.921.921l5.71-1.476A11.95 11.95 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.725 9.725 0 01-4.953-1.354l-.355-.211-3.684.951.974-3.567-.23-.368A9.724 9.724 0 012.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
  </svg>
`;

// Build pre-filled WhatsApp URLs using the Tamil text prefix
const whatsappChennaiUrl = `https://wa.me/${whatsapp_chennai.number}?text=${encodeURIComponent(whatsapp_chennai.textPrefixTa)}`;
const whatsappTrichyUrl  = `https://wa.me/${whatsapp_trichy.number}?text=${encodeURIComponent(whatsapp_trichy.textPrefixTa)}`;
---

<BaseLayout title="தொடர்புக்கு" lang="ta">
  <div py-12">

    <!-- Page header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-[#8B4513] mb-4">தொடர்பு கொள்ள</h2>
      <p class="text-[#B8860B] italic text-lg font-tamil">"ஜீவகாருண்யமே மோட்ச வீட்டின் திறவுகோல்."</p>
      <!-- Decorative gold divider -->
      <div class="h-1 w-24 bg-[#FFD700] mx-auto mt-6"></div>
    </div>

    <!-- Two-column grid — stacks to single column on mobile -->
    <div class="grid md:grid-cols-2 gap-12">

      <!-- ── Chennai Location ──────────────────────────────────────────────── -->
      <div class="bg-white p-8 rounded-2xl border border-[#FFD700]/30 shadow-lg hover:shadow-xl transition-shadow">
        <h3 class="text-2xl font-bold text-[#8B4513] mb-6 flex items-center gap-3">
          <span class="flex-shrink-0" set:html={BuildingIcon} aria-hidden="true" />
          ஒளிநெறி பீடம், சென்னை
        </h3>

        <div class="space-y-4 text-gray-700">
          <p class="flex items-start gap-3">
            <strong class="text-[#B8860B]">முகவரி:</strong>
            <span>
              அம்பலவாணர் குடில்,<br/>
              எண்.10/11, புதுத்தெரு, விநாயகபுரம்,
              அம்பத்தூர் ஓ.டி, சென்னை - 600053<br/>
              தமிழ்நாடு
            </span>
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொலைபேசி:</strong>
            <!-- tel: link enables tap-to-call on mobile devices -->
            <a href={`tel:+${whatsapp_chennai.number}`} class="hover:text-[#D4AF37]">
              {whatsapp_chennai.number_formatted}
            </a>
            <!-- WhatsApp link with pre-filled message -->
            <a
              href={whatsappChennaiUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`WhatsApp ${whatsapp_chennai.nameTa}`}
              class="text-[#25D366] hover:text-[#128C7E] transition-colors"
              set:html={WhatsAppIcon}
            />
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொடர்பாளர்:</strong>
            {whatsapp_chennai.nameEn}
          </p>
        </div>

        <!-- Embedded Google Map for Chennai location -->
        <div class="mt-8 rounded-xl overflow-hidden h-64 border border-gray-100">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d485.69137252877937!2d80.15099816019828!3d13.128871895075422!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a5263042a76416d%3A0xabc40e2f85891864!2sOlineri%20Peedam!5e0!3m2!1sen!2sin!4v1777216498763!5m2!1sen!2sin"
            title="ஒளிநெறி பீடம், சென்னை"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            sandbox="allow-scripts allow-same-origin allow-popups">
          </iframe>
        </div>
      </div>

      <!-- ── Trichy Location ───────────────────────────────────────────────── -->
      <div class="bg-white p-8 rounded-2xl border border-[#FFD700]/30 shadow-lg hover:shadow-xl transition-shadow">
        <h3 class="text-2xl font-bold text-[#8B4513] mb-6 flex items-center gap-3">
          <span class="flex-shrink-0" set:html={BuildingIcon} aria-hidden="true" /> 
          ஒளிநெறி பீடம், திருச்சி
        </h3>

        <div class="space-y-4 text-gray-700">
          <p class="flex items-start gap-3">
            <strong class="text-[#B8860B]">முகவரி:</strong> 
            <span>
              5, சோழா அவென்யூ,<br/>
              கல்லணை சாலை, திருவெறும்பூர்<br/>
              திருச்சி - 620013<br/> 
              தமிழ்நாடு
            </span>
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">Phone:</strong>
            <!-- tel: link enables tap-to-call on mobile devices -->
            <a href={`tel:+${whatsapp_trichy.number}`} class="hover:text-[#D4AF37]">
              {whatsapp_trichy.number_formatted}
            </a>
            <!-- WhatsApp link with pre-filled message -->
            <a
              href={whatsappTrichyUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`WhatsApp ${whatsapp_trichy.nameTa}`}
              class="text-[#25D366] hover:text-[#128C7E] transition-colors"
              set:html={WhatsAppIcon}
            />
          </p>
          <p class="flex items-center gap-3">
            <strong class="text-[#B8860B]">தொடர்பாளர்:</strong> 
            {whatsapp_trichy.nameEn}
          </p>
        </div>

        <!-- Embedded Google Map for Trichy location -->
        <div class="mt-8 rounded-xl overflow-hidden h-64 border border-gray-100">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.189087489129!2d78.76966361416419!3d10.7968253!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3baaf373379bdac5%3A0x19e4ff4579927bd6!2sManitham%20Homeo%20Healing%20Centre!5e0!3m2!1sen!2sin!4v1777217098188!5m2!1sen!2sin" 
            title="ஒளிநெறி பீடம், திருச்சி"
            width="100%"
            height="100%"
            style="border:0;" 
            allowfullscreen=""
            loading="lazy"
            sandbox="allow-scripts allow-same-origin allow-popups">
          </iframe>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>