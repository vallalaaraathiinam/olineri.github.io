---
import { Image } from 'astro:assets';
import { SITE_CONFIG, SEO_DATA } from '../constants/seo';
import '../styles/global.css';

const { 
  lang, 
  title,
  pageType
} = Astro.props;

const { pathname } = Astro.url;

// Get the page key (e.g., 'about', 'contact', or 'index' if empty)
const pathSegments = pathname.split('/').filter(Boolean);

let pageKey = pageType || (pathSegments.length <= 1 ? 'index' : pathSegments[1]);
if (title.includes('404') || title.toLowerCase().includes('not found')) {
  pageKey = '404';
}

// Fetch description from seo.js based on lang and detected pageKey
// Fallback to 'index' if the specific page key isn't found in SEO_DATA
const description = SEO_DATA[lang]?.[pageKey] || SEO_DATA[lang]?.index;

const isTamil = lang === 'ta';
const headerTitle = isTamil ? "வள்ளலார் ஆதியினம்" : "Vallalar Adhiyinam"
const headerTagLine = isTamil ? "எதுவும் என்னால் இல்லை, எதுவும் எனது இல்லை, எல்லாமும் எல்லோருக்கும்" : "Nothing is because of me, Nothing belongs to me, Everything is for everyone"

// Get and normalize the current URL path
const normalizedPathname = pathname.replace(/\/$/, ""); // Removes trailing slash for comparison

//Logic to calculate the "Opposite" page link
const pathWithSlash = pathname.endsWith("/") ? pathname : `${pathname}/`;
const toggleLink = isTamil 
  ? pathWithSlash.replace('/ta/', '/en/') 
  : pathWithSlash.replace('/en/', '/ta/');

// Links based on your FR
const menuLinks = [
  { en: 'Home', ta: 'முகப்பு', url: `/${lang}` },
  { en: 'About us', ta: 'எங்களைப் பற்றி', url: `/${lang}/about` },
  { en: 'Books', ta: 'புத்தகங்கள்', url: `/${lang}/books` },
  { en: 'Services', ta: 'சேவைகள்', url: `/${lang}/services` },
  { en: 'Learn', ta: 'கற்க', url: `/${lang}/learn` },
  { en: 'Contact', ta: 'தொடர்பு', url: `/${lang}/contact` },
  { en: 'Gallery', ta: 'புகைப்படங்கள்', url: `/${lang}/gallery` },
];

// Construct URLs
const canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.baseUrl);
const englishURL = new URL(pathWithSlash.replace('/ta/', '/en/'), SITE_CONFIG.baseUrl);
const tamilURL = new URL(pathWithSlash.replace('/en/', '/ta/'), SITE_CONFIG.baseUrl);

// Structured Data (JSON-LD)
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Vallalar Adhiyinam - Olineri Peedam",
  "url": SITE_CONFIG.baseUrl,
  "logo": `${SITE_CONFIG.baseUrl}/images/favicon.png`,
  "sameAs": [
    "https://x.com/olineri_peedam",
    "https://www.youtube.com/@vallalaradhiyinam3286"
  ]
};

---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Umami Analytics: privacy-first, no cookies, no consent banner needed -->
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="75c9f006-1487-44d6-815b-a03a1aa6a9c4"
    >
    </script>

    <!-- Canonical & Hreflang (Prevents Duplicate Content Penalty) -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="ta" href={tamilURL} />
    <link rel="alternate" hreflang="x-default" href={englishURL} />
    
    <!-- Open Graph (WhatsApp, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${headerTitle}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={SITE_CONFIG.ogImage} />
    
    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${headerTitle}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE_CONFIG.ogImage} />
    
    <!-- Structured Data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <title>{title} | {headerTitle}</title>

  </head>

  <body class="bg-white text-gray-900">
    
    <!-- Skip link: invisible until focused by keyboard Tab key -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-[#8B4513] focus:text-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-lg"
    >
      {isTamil ? 'உள்ளடக்கத்திற்கு செல்' : 'Skip to content'}
    </a>

    <header class="header-radiance w-full sticky top-0 z-50 shadow-sm">

      <!-- ═══════════════════════════════════════════════
           DESKTOP HEADER — md and above (768px+)
           Identical to your original — nothing changed
      ═══════════════════════════════════════════════ -->
      <div class="hidden md:block">
        <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col items-center text-center">
          <div class="w-full flex justify-between items-center mb-2">
            <Image 
              src="/images/header/vallalaar_face_shoulder.jpg" 
              alt="Vallalaar" 
              width={128} 
              height={128}
              format="webp"
              class="h-24 w-24 object-contain drop-shadow-md" 
            />
            <Image 
              src="/images/header/emblem.png" 
              alt="Emblem" 
              width={128} 
              height={128}
              format="webp"
              class="h-24 w-24 object-contain drop-shadow-lg" 
            />
            <Image 
              src="/images/header/founder.jpg" 
              alt="Founder" 
              width={128} 
              height={128}
              format="webp"
              class="h-24 w-24 object-contain drop-shadow-md" 
            />
          </div>
          <h1 class="text-5xl font-bold text-[#8B4513] uppercase tracking-tight" style="font-family: 'Playfair Display', serif;">
            {headerTitle}
          </h1>
          <div class="tagline-track">
            <span class="text-[#B8860B] italic text-xl font-medium">{headerTagLine}</span>
          </div>
        </div>

        <!-- Desktop nav strip -->
        <nav 
          aria-label={isTamil ? 'பிரதான வழிசெலுத்தல்' : 'Main navigation'}
          class="bg-[#FFEB3B]/10 border-t border-[#FFD700]/40"
        >
          <div class="max-w-6xl mx-auto px-4 py-3">
            <div class="flex flex-wrap justify-center items-center gap-8">
              {menuLinks.map(link => {
                const isActive = normalizedPathname === link.url || (link.url === `/${lang}` && normalizedPathname === "");
                return (
                  <a 
                    href={link.url} 
                    aria-current={isActive ? 'page' : undefined}
                    class={`text-[#8B4513] font-bold text-base hover:text-[#B8860B] transition-colors whitespace-nowrap ${isActive ? 'nav-link-active' : ''}`}
                  >
                    {isTamil ? link.ta : link.en}
                  </a>
                );
              })}
              <div class="border-l border-[#FFD700] pl-4 ml-2">
                <a 
                  href={toggleLink} 
                  lang={isTamil ? 'en' : 'ta'}
                  class="bg-[#8B4513] text-white px-6 py-2 rounded-full text-sm font-black hover:bg-[#B8860B] transition-all shadow-md"
                >
                  {isTamil ? 'ENGLISH' : 'தமிழ்'}
                </a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <!-- ═══════════════════════════════════════════════
           MOBILE HEADER — below md (0–767px)
           Slim bar: emblem + name + lang pill + hamburger
           Drawer slides down below the bar when opened
      ═══════════════════════════════════════════════ -->
      <div class="md:hidden flex flex-col">

        <!-- Line 1: Emblem, Title, and Founder -->
        <!-- Slim top bar — ~64px tall, fits one line -->
        <div class="flex items-center justify-between px-4 py-3 gap-2">

          <!-- Brand: small emblem + org name -->
          <div class="w-16 flex-shrink-0">
            <a
              href={`/${lang}`}
              class="flex items-center gap-3 min-w-0 flex-1"
              aria-label={isTamil ? 'முகப்பு' : 'Home'}
            >
              <Image
                src="/images/header/emblem.png"
                alt="Emblem"
                width={48}
                height={48}
                format="webp"
                class="h-16 w-16 object-contain drop-shadow-sm"
                aria-hidden="true"
              />
            </a>
          </div>

          <div class="flex-grow text-center min-w-0">
            <h1
              class="text-[#8B4513] font-bold text-xl leading-tight"
              style="font-family: 'Playfair Display', serif;"
            >
              {headerTitle}
            </h1>
          </div>
          
          <!-- Founder Photo on the far right -->
          <div class="w-16 flex-shrink-0 flex justify-end">
            <Image 
              src="/images/header/founder.jpg" 
              alt="Founder" 
              width={48} 
              height={48}
              format="webp"
              class="h-16 w-16 object-contain"
              aria-hidden="true"
            />
          </div>
        </div>

        <!-- Line 2: Tagline, Language Pill and Hamburger Actions -->
        <div class="flex items-center justify-between px-4 pb-3 pt-2 gap-4">
          
          <!-- Left side: Tagline -->
          <div id="mobile-tagline-track" class="mobile-tagline-track flex-1 overflow-hidden"
            style="position:relative; height:1.6em;">
            <span class="text-[#B8860B] italic text-[12px]"
              style="white-space:nowrap; position:absolute; line-height:1.6em;">
              {headerTagLine}
            </span>
          </div>
          <!--<p class="text-[#B8860B] italic text-[12px] leading-tight flex-1">
            <span>{headerTagLine}</span>
          </p>-->
          
          <!-- Actions: Compact Language pill + hamburger -->
          <div class="flex items-center gap-2 flex-shrink-0">
            <a
              href={toggleLink}
              lang={isTamil ? 'en' : 'ta'}
              class="bg-[#8B4513] text-white text-xs font-black px-3 py-1.5 rounded-full hover:bg-[#B8860B] transition-all shadow-sm"
            >
              {isTamil ? 'EN' : 'த'}
            </a>

            <button
              id="mobile-menu-btn"
              aria-controls="mobile-drawer"
              aria-expanded="false"
              aria-label={isTamil ? 'மெனுவைத் திற' : 'Open menu'}
              class="flex flex-col justify-center items-center gap-[5px] w-10 h-10 rounded-lg border border-[#FFD700]/60 bg-[#FFFDF0] hover:bg-[#FFF9C4] transition-colors flex-shrink-0"
            >
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
              <span class="hamburger-line"></span>
            </button>
          </div>
        </div>

        <!-- Slide-down nav drawer -->
        <nav
          id="mobile-drawer"
          aria-label={isTamil ? 'பிரதான வழிசெலுத்தல்' : 'Main navigation'}
          class="border-t border-[#FFD700]/40 bg-[#FFFDF0]"
        >
          <ul role="list" class="py-2">
            {menuLinks.map(link => {
              const isActive = normalizedPathname === link.url || (link.url === `/${lang}` && normalizedPathname === "");
              return (
                <li>
                  <a
                    href={link.url}
                    aria-current={isActive ? 'page' : undefined}
                    class={`drawer-link flex items-center px-6 py-3.5 text-[#8B4513] font-bold text-base transition-colors hover:bg-[#FFF9C4] ${isActive ? 'drawer-link-active' : ''}`}
                  >
                    {isTamil ? link.ta : link.en}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

      </div>
      <!-- end mobile header -->

    </header>

    <main id="main-content" class="max-w-4xl mx-auto px-6 py-10">
      <slot />
    </main>

    <footer class="bg-gray-100 border-t border-amber-200 mt-20 py-10">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <img src="/images/header/emblem.png" alt="Logo" class="h-10 mx-auto opacity-40 grayscale mb-4" />
        <p class="text-sm text-gray-600">
          {isTamil ? "© 2026 வள்ளலார் ஆதியினம், பதிவு எண்: 145/2022-IV" : "© 2026 Vallalar Adhiyinam, Regn. No: 145/2022-IV"}
        </p>
        <p class="text-xs text-gray-500 mt-2">
          {isTamil ? "உன்னுள் ஒளி, உணர்ந்து தெளி" : "Light within you, Realize to see True"}
        </p>
      </div>
    </footer>

    <!-- Scroll to Top Button -->
    <button
      id="to-top"
      aria-label="Scroll to top"
      class="fixed bottom-8 right-8 z-[60] flex h-12 w-12 translate-y-20 items-center justify-center rounded-full bg-[#8B4513] text-white shadow-2xl transition-all duration-300 hover:bg-[#B8860B] active:scale-95"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>

    <!-- Scroll to top -->
    <script src="/scripts/scrollToTop.js" defer></script>

    <!-- Hamburger menu toggle -->
    <script src="/scripts/hamburgerMenuToggle.js" defer></script>

    <!-- Marquee for Header Tag Line -->
    <script src="/scripts/marquee.js" defer></script>
  </body>
</html>