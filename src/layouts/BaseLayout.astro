---
import { Image } from 'astro:assets';
import { SITE_CONFIG } from '../constants/seo';

const { 
  lang, 
  title,
  description = lang === 'ta' 
    ? "ஒளிநெறி பீடம் - வள்ளலார் ஆதியினம்" 
    : "Olineri Peedam - Official website of Vallalar Adhiyinam",
    pageType = 'index'
  } = Astro.props;

const isTamil = lang === 'ta';
const webTitle = isTamil ? "வள்ளலார் ஆதியினம்" : "Vallalar Adhiyinam"

// Get and normalize the current URL path
const { pathname } = Astro.url;
const normalizedPathname = pathname.replace(/\/$/, ""); // Removes trailing slash for comparison

//Logic to calculate the "Opposite" page link
const toggleLink = isTamil 
  ? pathname.replace('/ta/', '/en/') 
  : pathname.replace('/en/', '/ta/');

// Links based on your FR
const menuLinks = [
  { en: 'Home', ta: 'முகப்பு', url: `/${lang}` }, // Removed trailing slash for normalization
  { en: 'About us', ta: 'எங்களைப் பற்றி', url: `/${lang}/about` },
  { en: 'Books', ta: 'புத்தகங்கள்', url: `/${lang}/books` },
  { en: 'Services', ta: 'சேவைகள்', url: `/${lang}/services` },
  { en: 'Learn', ta: 'கற்க', url: `/${lang}/learn` },
  { en: 'Contact', ta: 'தொடர்பு', url: `/${lang}/contact` },
  { en: 'Gallery', ta: 'புகைப்படங்கள்', url: `/${lang}/gallery` },
];

// Construct URLs
const canonicalURL = new URL(Astro.url.pathname, SITE_CONFIG.baseUrl);
const englishURL = new URL(Astro.url.pathname.replace('/ta/', '/en/'), SITE_CONFIG.baseUrl);
const tamilURL = new URL(Astro.url.pathname.replace('/en/', '/ta/'), SITE_CONFIG.baseUrl);

// Structured Data (JSON-LD)
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Vallalar Adhiyinam - Olineri Peedam",
  "url": SITE_CONFIG.baseUrl,
  "logo": `${SITE_CONFIG.baseUrl}/images/favicon.png`,
  "sameAs": [
    "https://x.com/olineri_peedam",
    "https://www.youtube.com/@vallalaradhiyinam3286"
  ]
};

---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical & Hreflang (Prevents Duplicate Content Penalty) -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="ta" href={tamilURL} />
    <link rel="alternate" hreflang="x-default" href={englishURL} />
    
    <!-- 2. Open Graph (WhatsApp, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ${webTitle}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={SITE_CONFIG.ogImage} />
    
    <!-- 3. Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${webTitle}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE_CONFIG.ogImage} />
    
    <!-- 4. Structured Data (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <title>{title} | {webTitle}</title>
      <style is:global>
        body { 
          background-color: #FFFDF0; 
          color: #3E2F22;
          font-family: 'Arima', sans-serif;
        }

        .header-radiance {
          background: linear-gradient(180deg, #FFF9C4 0%, #FFFDF0 100%);
          border-bottom: 2px solid #FFD700;
        }

        /* Active Link Underline Effect */
        .nav-link-active {
          color: #B8860B !important;
          border-bottom: 3px solid #8B4513;
          padding-bottom: 2px;
        }
      </style>
  </head>
  <body class="bg-white text-gray-900">
    
    <header class="header-radiance w-full sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col items-center text-center">
        <div class="w-full flex justify-between items-center mb-4 md:mb-8">
          <Image 
            src="/images/header/vallalaar_face_shoulder.jpg" 
            alt="Vallalaar" 
            width={128} 
            height={128}
            format="webp"
            class="h-16 w-16 md:h-32 md:w-32 object-contain drop-shadow-md" 
          />
          <Image 
            src="/images/header/emblem.png" 
            alt="Emblem" 
            width={128} 
            height={128}
            format="webp"
            class="h-16 w-16 md:h-32 md:w-32 object-contain drop-shadow-lg" 
          />
          <Image 
            src="/images/header/founder.jpg" 
            alt="Founder" 
            width={128} 
            height={128}
            format="webp"
            class="h-16 w-16 md:h-32 md:w-32 object-contain drop-shadow-md" 
          />
        </div>
        <div class="space-y-2">
          <h1 class="text-3xl md:text-5xl font-bold text-[#8B4513] uppercase tracking-tight" style="font-family: 'Playfair Display', serif;">
            {isTamil ? "வள்ளலார் ஆதியினம்" : "Vallalar Adhiyinam"}
          </h1>
          <p class="text-[#B8860B] italic text-base md:text-xl font-medium">
            {isTamil ? "எதுவும் என்னால் இல்லை, எதுவும் எனது இல்லை, எல்லாமும் எல்லோருக்கும்" : "Nothing is because of me, Nothing belongs to me, Everything is for everyone"}
          </p>
        </div>
      </div>

      <nav class="bg-[#FFEB3B]/10 border-t border-[#FFD700]/40">
        <div class="max-w-6xl mx-auto px-4 py-3">
          <div class="flex flex-wrap justify-start md:justify-center items-center gap-4 md:gap-8">
            {menuLinks.map(link => {
              // Check if normalized link URL matches normalized pathname
              const isActive = normalizedPathname === link.url || (link.url === `/${lang}` && normalizedPathname === "");
              
              return (
                <a 
                  href={link.url} 
                  class={`text-[#8B4513] font-bold text-sm md:text-base hover:text-[#B8860B] transition-colors whitespace-nowrap ${isActive ? 'nav-link-active' : ''}`}
                >
                  {isTamil ? link.ta : link.en}
                </a>
              );
            })}
            
            <div class="border-l border-[#FFD700] pl-4 ml-2">
              <a href={toggleLink} class="bg-[#8B4513] text-white px-6 py-2 rounded-full text-sm font-black hover:bg-[#B8860B] transition-all shadow-md">
                {isTamil ? 'ENGLISH' : 'தமிழ்'}
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-10">
      <slot />
    </main>

    <footer class="bg-gray-100 border-t border-amber-200 mt-20 py-10">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <img src="/images/header/emblem.png" alt="Logo" class="h-10 mx-auto opacity-40 grayscale mb-4" />
        <p class="text-sm text-gray-600">
          {isTamil ? "© 2026 வள்ளலார் ஆதியினம்" : "© 2026 Vallalar Adhiyinam"}
        </p>
        <p class="text-xs text-gray-500 mt-2">
          {isTamil ? "உன்னுள் ஒளி, உணர்ந்து தெளி" : "Light within you, Realize to see True"}
        </p>
      </div>
    </footer>
  </body>
</html>